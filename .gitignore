# ============================================================
# .gitignore — PowerShell / Bash / GCP / Docker project
# ============================================================

# Secrets and credentials — NEVER commit these
.env
*.env
*.pem
*.key
*.ppk
secrets/
credentials.json

# SSH keys
*.pub
id_rsa
id_ed25519

# GCP / gcloud
.gcloud/
application_default_credentials.json

# Temporary scripts generated at runtime
docker28-startup.sh
traefik-setup.sh

# OS noise
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Windows
$RECYCLE.BIN/
*.lnk

# PowerShell
*.ps1xml

# Logs and output
*.log
*.tmp
*.bak

# Editor directories
.vscode/
.idea/
*.swp
*.swo
