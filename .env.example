# ============================================================
# .env.example — template for local configuration
# Copy to .env and fill in your real values
# The .env file is gitignored; this template is safe to commit
# ============================================================

# GCP Configuration
PROJECT=YOUR_GCP_PROJECT_ID
ZONE=us-south1-c
VM_NAME=ubuntu-vm-docker28
MACHINE_TYPE=n2-custom-4-16384

# SSH keys (absolute paths to your key pair)
SSH_KEY_FILE=YOUR_SSH_KEY_PATH.pub
SSH_KEY_PRIV=YOUR_SSH_KEY_PATH
SSH_USERNAME=gcvmuser

# Traefik
TRAEFIK_DIR=/home/gcvmuser/traefik
ADMIN_PASS=YOUR_ADMIN_PASSWORD
ACME_EMAIL=YOUR_EMAIL@example.com
DOMAIN=your-domain.com

# Cloudflare DNS API token (for Let's Encrypt DNS-01 challenge)
CF_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# Firewall rule names (must match deploy and destroy scripts)
FW_RULE_SSH=allow-ssh-external
FW_RULE_WEB=allow-http-https-external
